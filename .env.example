# ============================================================
# 环境变量模板
# 用法：复制本文件为 .env，再填入真实值
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
# .env 不会被提交到 Git，可放心填写密钥
# ============================================================

# 被测 Dify 应用地址（本地虚拟机 / 服务器，形如 http://192.168.x.x）
DIFY_BASE_URL=http://your-dify-host

# Dify 应用 API Key（在应用的「访问 API」页面获取，app- 开头）
DIFY_API_KEY=app-xxxxxxxx

# DeepEval 评委模型 API Key（阿里云百炼 DashScope，sk- 开头）
DASHSCOPE_API_KEY=sk-xxxxxxxx
